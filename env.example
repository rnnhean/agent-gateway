# 主 provider（Anthropic 原生协议）
LLM_BASE_URL=https://your-endpoint.example.com
LLM_API_KEY=YOUR_KEY_HERE
LLM_MODEL=YOUR_MODEL_NAME

# 后备 provider（可选，配了才会启用故障转移）
FALLBACK_API_KEY=YOUR_FALLBACK_KEY_HERE

# 限流：容量（突发）与稳态速率
RL_CAPACITY=60
RL_REFILL=10

# 上游并发上限
MAX_CONCURRENCY=16

# 每租户预算（USD）
TENANT_BUDGET_USD=10

# 缓存开关（1/0）
CACHE_ENABLED=1

PORT=8794
